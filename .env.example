# ============================================================================
# Landed Digital - configuration reference
# ----------------------------------------------------------------------------
# This is a STATIC site (no build step, no Node). There is no runtime .env.
# These values live in js/config.js under window.LANDED. This file documents
# what to set and where. Copy the value into js/config.js, do not commit real
# secrets anywhere public. Form/analytics IDs below are public by nature.
# ============================================================================

# Business identity  -> config.js > business
BUSINESS_EMAIL=contact@landedgroupau.com        # shared Landed contact address
BUSINESS_PHONE=0403 385 125                     # displayed phone [CONFIRM shared Landed line]
BUSINESS_ABN=19 698 633 448                      # Landed Group ABN
BUSINESS_DOMAIN=https://digital.landedgroupau.com

# Forms  -> config.js > integrations  (shared Landed Formspree account)
FORMSPREE_ID=xgoqddbl                            # forms post to formspree.io/f/<id>

# Booking  -> config.js > integrations.bookingUrl (leave blank to hide booking UI)
BOOKING_URL=                                     # Calendly / Cal.com link

# Google Business Profile  -> config.js > integrations.googleBusinessProfile
GOOGLE_BUSINESS_PROFILE_URL=

# Analytics & Ads (only loaded if set)  -> config.js > integrations
GA4_ID=                                          # e.g. G-XXXXXXXXXX
GOOGLE_ADS_ID=                                   # e.g. AW-XXXXXXXXX
GOOGLE_ADS_CONVERSION_LABEL=                     # e.g. AW-XXXXXXXXX/xxxxxxxxxxxx
META_PIXEL_ID=

# Social  -> config.js > social
LINKEDIN_URL=https://www.linkedin.com/company/landed-group-pty-ltd/
INSTAGRAM_URL=
FACEBOOK_URL=
